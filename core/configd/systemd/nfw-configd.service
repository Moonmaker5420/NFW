[Unit]
Description=NFW privileged configuration daemon
Documentation=file:/opt/nfw/docs/PHASE1.md
After=network-pre.target
Before=nftables.service
Wants=network-pre.target
ConditionPathExists=/opt/nfw/core/configd/configd.py

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/nfw/core/configd/configd.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
User=root
Group=root
RuntimeDirectory=nfw
RuntimeDirectoryMode=0750
StateDirectory=nfw
StateDirectoryMode=0750
LogsDirectory=nfw
LogsDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
