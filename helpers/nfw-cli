def cmd_user_list(args):
    _require_configd()
    r = call("users.list")
    users = r.get("users") if isinstance(r, dict) else r

    # Normalize to a list of dicts
    if isinstance(users, dict):
        rows = []
        for name, rec in users.items():
            row = dict(rec) if isinstance(rec, dict) else {}
            row.setdefault("username", name)
            rows.append(row)
    elif isinstance(users, list):
        rows = users
    else:
        _print_json(r)
        return

    for rec in rows:
        name = rec.get("username", "?")
        role = rec.get("role", "?")
        disabled = "disabled" if rec.get("disabled") else "active"
        print(f"  {name:20s} {role:10s} {disabled}")


def cmd_user_reset_password(args):
    _require_configd()
    if bcrypt is None:
        die("bcrypt not available (venv missing?)")
    name = args.username
    pw1 = getpass.getpass(f"New password for {name}: ")
    pw2 = getpass.getpass("Confirm: ")
    if pw1 != pw2:
        die("passwords do not match")
    if len(pw1) < 6:
        die("password must be at least 6 characters")
    h = bcrypt.hashpw(pw1.encode(), bcrypt.gensalt()).decode()
    call("users.set_password", {"username": name, "hash": h})
    print(f"password for {name} updated")


