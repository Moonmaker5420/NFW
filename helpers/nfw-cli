def cmd_interface_list(args):
    _require_configd()
    try:
        r = call("network.assignments")
    except Exception as e:
        die(f"cannot read assignments: {e}")
    net = r.get("network") or {}
    resolved = r.get("resolved") or {}
    print(f"  WAN: {net.get('wan') or resolved.get('wan') or '(unassigned)'}")
    print(f"  LAN: {net.get('lan') or resolved.get('lan') or '(unassigned)'}")
    print()
    devs = r.get("devices") or []
    if devs:
        print(f"  {'NAME':12s} {'STATE':8s} {'MAC':20s} ADDRESS")
        for d in devs:
            name = d.get("name", "?")
            state = d.get("state", "?")
            mac = d.get("mac", "")
            addrs = d.get("addrs") or []
            astr = ", ".join(
                f"{a.get('address')}/{a.get('prefixlen')}"
                for a in addrs if a.get("address")
            ) or "—"
            print(f"  {name:12s} {state:8s} {mac:20s} {astr}")


def cmd_interface_set(args):
    _require_configd()
    role = args.role.lower()
    iface = args.iface
    try:
        r = call("network.assignments")
    except Exception as e:
        die(f"cannot read assignments: {e}")
    net = dict(r.get("network") or {})
    if role == "wan":
        net["wan"] = iface
    else:
        net["lan"] = iface
    net.setdefault("opt", [])
    if net.get("wan") == net.get("lan"):
        die(f"WAN and LAN cannot both be {iface}")
    print(f"setting {role} -> {iface}")
    try:
        res = call("network.apply_assignment",
                   {"network": net, "author": "nfw-cli"})
    except Exception as e:
        die(f"apply failed: {e}")
    print(f"  revision: {res.get('revision')}")
    print(f"  applied:  {res.get('applied')}")
    if res.get("apply_error"):
        print(f"  error:    {res['apply_error']}")


def cmd_lan_ip(args):
    _require_configd()
    cidr = args.cidr
    if "/" not in cidr:
        die("expected <ip>/<prefix>, e.g. 192.168.10.1/24")
    addr, plen = cidr.split("/", 1)
    try:
        plen_i = int(plen)
    except ValueError:
        die("invalid prefix length")
    if not (1 <= plen_i <= 32):
        die("prefix must be 1-32")

    try:
        r = call("network.assignments")
    except Exception as e:
        die(f"cannot read assignments: {e}")
    net = r.get("network") or {}
    lan = net.get("lan")
    if not lan or lan == "auto":
        die("LAN interface not assigned — run: nfw-cli interface set lan <iface>")

    print(f"setting LAN {lan} -> {addr}/{plen_i}")
    try:
        call("network.iface.set", {
            "device": lan,
            "config": {
                "ipv4": {"mode": "static", "address": addr, "prefixlen": plen_i},
                "ipv6": {"mode": "none"},
            },
            "author": "nfw-cli",
        })
        res = call("network.iface.apply", {"author": "nfw-cli"})
    except Exception as e:
        die(f"apply failed: {e}")
    print("  ok")
    _print_json(res)


