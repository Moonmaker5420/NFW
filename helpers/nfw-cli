def cmd_power_reboot(args):
    _require_configd()
    print("scheduling reboot in 5 seconds...")
    print(f"  {call('power.reboot', {'delay_seconds': 5})}")


def cmd_power_shutdown(args):
    _require_configd()
    print("scheduling shutdown in 5 seconds...")
    print(f"  {call('power.shutdown', {'delay_seconds': 5})}")


def cmd_power_cancel(args):
    _require_configd()
    print(f"  {call('power.cancel', {})}")


# ---------------------------------------------------------------------------
def build_parser():
    p = argparse.ArgumentParser(
        prog="nfw-cli",
        description="NFW console recovery tool. Run as root.",
        epilog="For routine administration, prefer the GUI at "
               "https://<lan-ip>:8443",
    )
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")

    sub.add_parser("status", help="overall health check").set_defaults(
        func=cmd_status)

    sp = sub.add_parser("service", help="manage NFW services")
    ss = sp.add_subparsers(dest="subcmd")
    ss.add_parser("list", help="list service states").set_defaults(
        func=cmd_service_list)
    sp2 = ss.add_parser("restart", help="restart a service")
    sp2.add_argument("name")
    sp2.set_defaults(func=cmd_service_restart)

    sp = sub.add_parser("interface", help="network interface management")
    ss = sp.add_subparsers(dest="subcmd")
    ss.add_parser("list", help="list NICs and roles").set_defaults(
        func=cmd_interface_list)
    sp2 = ss.add_parser("set", help="assign WAN or LAN role")
    sp2.add_argument("role", choices=["wan", "lan"])
    sp2.add_argument("iface")
    sp2.set_defaults(func=cmd_interface_set)

    sp = sub.add_parser("lan-ip", help="change LAN IP (e.g. 192.168.10.1/24)")
    sp.add_argument("cidr")
    sp.set_defaults(func=cmd_lan_ip)

    sp = sub.add_parser("firewall", help="firewall operations")
    ss = sp.add_subparsers(dest="subcmd")
    ss.add_parser("apply", help="reapply firewall from config").set_defaults(
        func=cmd_firewall_apply)
    ss.add_parser("show", help="show current nft ruleset").set_defaults(
        func=cmd_firewall_show)
    ss.add_parser("disable", help="PANIC — flush firewall to accept-all").set_defaults(
        func=cmd_firewall_disable)

    sp = sub.add_parser("config", help="config store operations")
    ss = sp.add_subparsers(dest="subcmd")
    ss.add_parser("show", help="print active config").set_defaults(
        func=cmd_config_show)
    ss.add_parser("revisions", help="list revisions").set_defaults(
        func=cmd_config_revisions)
    sp2 = ss.add_parser("rollback", help="roll back to a revision")
    sp2.add_argument("revision")
    sp2.set_defaults(func=cmd_config_rollback)

    sp = sub.add_parser("user", help="user management")
    ss = sp.add_subparsers(dest="subcmd")
    ss.add_parser("list", help="list users").set_defaults(func=cmd_user_list)
    sp2 = ss.add_parser("reset-password", help="reset a user's password")
    sp2.add_argument("username")
    sp2.set_defaults(func=cmd_user_reset_password)

    sp = sub.add_parser("alerts", help="alert operations")
    ss = sp.add_subparsers(dest="subcmd")
    ss.add_parser("test", help="send a test email").set_defaults(
        func=cmd_alerts_test)
    sp2 = ss.add_parser("history", help="show recent alert history")
    sp2.add_argument("--limit", type=int, default=20)
    sp2.set_defaults(func=cmd_alerts_history)

    sp = sub.add_parser("power", help="power operations")
    ss = sp.add_subparsers(dest="subcmd")
    ss.add_parser("reboot", help="reboot in 5 seconds").set_defaults(
        func=cmd_power_reboot)
    ss.add_parser("shutdown", help="shut down in 5 seconds").set_defaults(
        func=cmd_power_shutdown)
    ss.add_parser("cancel", help="cancel a pending power action").set_defaults(
        func=cmd_power_cancel)

    return p


def main(argv=None):
    _require_root()
    parser = build_parser()
    args = parser.parse_args(argv)

    if not hasattr(args, "func"):
        parser.print_help()
        print()
        print("Common recovery scenarios:")
        print("  nfw-cli status                        # is everything up?")
        print("  nfw-cli interface list                # check NIC roles")
        print("  nfw-cli interface set lan enp2s0      # fix LAN assignment")
        print("  nfw-cli lan-ip 192.168.10.1/24        # change LAN IP")
        print("  nfw-cli firewall apply                # reapply rules")
        print("  nfw-cli firewall disable              # PANIC — accept all")
        print("  nfw-cli config revisions              # list revisions")
        print("  nfw-cli config rollback <rev>         # undo last change")
        print("  nfw-cli user reset-password admin     # recover admin")
        return 2

    try:
        return args.func(args) or 0
    except KeyboardInterrupt:
        print("\naborted", file=sys.stderr)
        return 130
    except RuntimeError as e:
        die(str(e))


if __name__ == "__main__":
    sys.exit(main())
