#!/usr/bin/env python3
"""
nfw-cli — console recovery tool for NFW.

Runs as root, talks to nfw-configd over the Unix socket. Use when the GUI
is unreachable: broken firewall, wrong LAN IP, misconfigured interfaces,
locked-out admin.

For routine administration, prefer the GUI at https://<lan-ip>:8443
"""
from __future__ import annotations

import argparse
import datetime
import getpass
import json
import os
import socket
import subprocess
import sys
import tempfile
import time

SOCK = "/run/nfw/configd.sock"
CONFIG_DIR = "/var/lib/nfw/config"

# Try bcrypt. If not available, try re-exec with venv python.
try:
    import bcrypt  # type: ignore
except ImportError:
    _venv_py = "/opt/nfw/venv/bin/python3"
    if os.path.exists(_venv_py) and os.path.realpath(sys.executable) != os.path.realpath(_venv_py):
        os.execv(_venv_py, [_venv_py] + sys.argv)
    bcrypt = None  # type: ignore


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def call(action, data=None, timeout=30):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCK)
    except OSError as e:
        raise RuntimeError(f"cannot connect to {SOCK}: {e}")
    try:
        payload = json.dumps({"action": action, "data": data or {}}).encode() + b"\n"
        s.sendall(payload)
        buf = bytearray()
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            buf.extend(chunk)
            if buf.endswith(b"\n"):
                break
        try:
            resp = json.loads(buf.decode())
        except Exception as e:
            raise RuntimeError(f"invalid response from configd: {e}")
        if not resp.get("ok"):
            raise RuntimeError(resp.get("error", "configd error"))
        return resp.get("result")
    finally:
        try:
            s.close()
        except OSError:
            pass


def _require_root():
    if os.geteuid() != 0:
        die("nfw-cli must be run as root (try: sudo nfw-cli ...)")


def _require_configd():
    if not os.path.exists(SOCK):
        die(f"configd socket {SOCK} not found — is nfw-configd running?\n"
            f"  systemctl status nfw-configd\n"
            f"  journalctl -u nfw-configd -n 50")


def _print_json(obj):
    print(json.dumps(obj, indent=2, sort_keys=True))


def _confirm(prompt="Type 'yes' to continue: "):
    return input(prompt).strip() == "yes"


# ---------------------------------------------------------------------------
def cmd_status(args):
    _require_configd()
    print("=== services ===")
    for svc in ("nfw-configd", "nfw-api", "nfw-portal"):
        try:
            r = subprocess.run(["systemctl", "is-active", svc],
                               capture_output=True, text=True, timeout=5)
            state = r.stdout.strip() or "unknown"
        except Exception:
            state = "unknown"
        mark = "OK " if state == "active" else "!! "
        print(f"  {mark} {svc:20s} {state}")

    print("\n=== interfaces ===")
    try:
        r = call("network.assignments")
        net = (r or {}).get("network") or {}
        print(f"  WAN: {net.get('wan') or '(unassigned)'}")
        print(f"  LAN: {net.get('lan') or '(unassigned)'}")
        print()
        devs = (r or {}).get("devices") or []
        for d in devs:
            name = d.get("name", "?")
            state = d.get("state", "?")
            addrs = d.get("addrs") or []
            astr = ", ".join(
                f"{a.get('address')}/{a.get('prefixlen')}"
                for a in addrs if a.get("address")
            ) or "—"
            print(f"  {name:12s} {state:8s} {astr}")
    except Exception as e:
        print(f"  error: {e}")

    print("\n=== API health ===")
    try:
        r = subprocess.run(
            ["curl", "-sk", "--max-time", "5",
             "https://127.0.0.1:8443/api/health"],
            capture_output=True, text=True, timeout=10)
        print(f"  {r.stdout.strip() or '(no response)'}")
    except Exception as e:
        print(f"  error: {e}")


def cmd_service_list(args):
    for u in ("nfw-configd", "nfw-api", "nfw-portal",
              "nfw-fix-nfw-perms", "nfw-fix-ca-perms"):
        try:
            r = subprocess.run(["systemctl", "is-active", u],
                               capture_output=True, text=True, timeout=5)
            print(f"  {u:22s} {r.stdout.strip() or 'unknown'}")
        except Exception:
            print(f"  {u:22s} error")


def cmd_service_restart(args):
    name = args.name
    if not name.startswith("nfw-"):
        name = "nfw-" + name
    print(f"restarting {name}...")
    r = subprocess.run(["systemctl", "restart", name],
                       capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        die(f"restart failed: {r.stderr.strip()}")
    r = subprocess.run(["systemctl", "is-active", name],
                       capture_output=True, text=True, timeout=5)
    print(f"  {name}: {r.stdout.strip()}")


