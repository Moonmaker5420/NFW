def cmd_alerts_test(args):
    _require_configd()
    print("sending test email...")
    r = call("alerts.test", {})
    if r.get("ok"):
        print("  sent")
    else:
        die(f"failed: {r.get('error', 'unknown')}")


def cmd_alerts_history(args):
    _require_configd()
    r = call("alerts.history", {"limit": args.limit})
    print(f"stats: {r.get('stats')}")
    for a in r.get("alerts", [])[:args.limit]:
        when = datetime.datetime.fromtimestamp(a["ts"]).strftime("%Y-%m-%d %H:%M:%S")
        print(f"  {when}  {a['event']:24s} {a['status']:10s} {a.get('error','')[:50]}")


