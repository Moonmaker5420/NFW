def cmd_firewall_apply(args):
    _require_configd()
    print("applying firewall from current config...")
    try:
        res = call("firewall.apply_staged", {})
    except Exception as e:
        die(f"apply failed: {e}")
    print(f"  applied:  {res.get('applied')}")
    print(f"  bytes:    {res.get('bytes')}")
    print(f"  revision: {res.get('revision')}")


def cmd_firewall_show(args):
    try:
        r = subprocess.run(["nft", "list", "ruleset"],
                           capture_output=True, text=True, timeout=10)
    except Exception as e:
        die(f"nft failed: {e}")
    showing = False
    for ln in r.stdout.splitlines():
        if ln.startswith("table"):
            showing = ("nfw_filter" in ln or "nfw_nat" in ln)
        if showing:
            print(ln)


def cmd_firewall_disable(args):
    _require_configd()
    print("!! PANIC: disabling firewall !!!")
    print("   Policy will be set to ACCEPT — all traffic passes.")
    print("   Re-enable with: nfw-cli firewall apply")
    print()
    if not _confirm():
        die("aborted", 2)
    minimal = (
        "# NFW — panic mode, loaded by nfw-cli firewall disable\n"
        "flush ruleset\n"
        "table inet filter {\n"
        "  chain input { type filter hook input priority filter; policy accept; }\n"
        "  chain forward { type filter hook forward priority filter; policy accept; }\n"
        "  chain output { type filter hook output priority filter; policy accept; }\n"
        "}\n"
    )
    with tempfile.NamedTemporaryFile("w", suffix=".nft", delete=False) as f:
        f.write(minimal)
        path = f.name
    try:
        r = subprocess.run(["nft", "-f", path],
                           capture_output=True, text=True, timeout=10)
        if r.returncode != 0:
            die(f"nft load failed: {r.stderr.strip()}")
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
    print("firewall disabled (policy accept)")
    print("NOTE: /etc/nftables.conf is unchanged. A reboot or")
    print("      `systemctl restart nftables` will reapply the real rules.")


