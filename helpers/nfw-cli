def cmd_config_show(args):
    path = os.path.join(CONFIG_DIR, "active.json")
    if not os.path.exists(path):
        die(f"{path} not found")
    active = json.load(open(path))
    rev = active.get("revision", "")
    rev_path = os.path.join(CONFIG_DIR, "revisions", f"{rev}.json")
    if not os.path.exists(rev_path):
        die(f"active revision file {rev_path} not found")
    print(f"# revision: {rev}")
    print(open(rev_path).read())


def cmd_config_revisions(args):
    rev_dir = os.path.join(CONFIG_DIR, "revisions")
    if not os.path.isdir(rev_dir):
        die(f"{rev_dir} not found")
    entries = []
    for name in os.listdir(rev_dir):
        if not name.endswith(".json"):
            continue
        path = os.path.join(rev_dir, name)
        entries.append((os.path.getmtime(path), name[:-5]))
    entries.sort(reverse=True)
    active = json.load(open(os.path.join(CONFIG_DIR, "active.json")))
    cur = active.get("revision", "")
    for mtime, rev in entries[:40]:
        when = datetime.datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M")
        mark = " (active)" if rev == cur else ""
        print(f"  {when}  {rev}{mark}")


def cmd_config_rollback(args):
    rev = args.revision
    rev_path = os.path.join(CONFIG_DIR, "revisions", f"{rev}.json")
    if not os.path.exists(rev_path):
        die(f"revision {rev} not found")
    print(f"rolling back to {rev}")
    if not _confirm():
        die("aborted", 2)
    active_path = os.path.join(CONFIG_DIR, "active.json")
    with open(active_path, "w") as f:
        json.dump({"revision": rev, "ts": int(time.time())}, f, indent=2)
    try:
        subprocess.run(["chown", "root:nfw", active_path], timeout=5)
        subprocess.run(["chmod", "0640", active_path], timeout=5)
    except Exception:
        pass
    print("active revision set. Restarting configd to pick it up...")
    subprocess.run(["systemctl", "restart", "nfw-configd"], timeout=30)
    print("done")


