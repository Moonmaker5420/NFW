[Unit]
Description=NFW privileged configuration daemon
Documentation=file:/opt/nfw/docs/PHASE1.md
After=network-pre.target
Before=nftables.service
Wants=network-pre.target
ConditionPathExists=/opt/nfw/core/configd/configd.py

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'mkdir -p /var/lib/nfw /run/nfw && chown root:nfw /var/lib/nfw /run/nfw && chmod 0750 /var/lib/nfw /run/nfw'
ExecStart=/usr/bin/python3 /opt/nfw/core/configd/configd.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
User=root
Group=root
RuntimeDirectory=nfw
RuntimeDirectoryMode=0750
# NFW-KEEP-PARENT-OWNERSHIP — do not let systemd reset /var/lib/nfw group
# StateDirectory=nfw
# StateDirectoryMode=0750
LogsDirectory=nfw
LogsDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=-/etc/nfw -/etc/nftables.conf -/etc/suricata -/var/lib/suricata -/var/log/suricata -/var/lib/nfw/shaper -/etc/wireguard -/etc/openvpn -/etc/swanctl -/etc/ipsec.conf -/etc/ipsec.secrets -/var/log -/etc/systemd/network -/etc/dhcp -/etc/unbound -/etc/chrony -/etc/default/isc-dhcp-server -/var/lib/dhcp -/var/lib/unbound -/var/lib/chrony -/etc/haproxy -/etc/squid -/etc/letsencrypt -/etc/snmp -/var/www -/var/lib/haproxy -/var/lib/squid -/etc/miniupnpd -/var/lib/miniupnpd -/run/miniupnpd -/var/lib/nfw/pcap -/var/lib/nfw/ca -/etc/systemd/system/nfw-api.service.d -/etc/systemd/system/nfw-configd.service.d -/var/lib/nfw/rrd -/etc/freeradius -/var/lib/nfw/captiveportal
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
