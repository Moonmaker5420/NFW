[Unit]
Description=NFW API (FastAPI backend)
Documentation=file:/opt/nfw/docs/PHASE2.md
After=network.target nfw-configd.service nfw-fix-ca-perms.service
Wants=nfw-configd.service
ConditionPathExists=/opt/nfw/core/api/main.py

[Service]
Type=simple
User=www-data
Group=nfw
WorkingDirectory=/opt/nfw/core
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/nfw/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/nfw/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8080 --workers 1
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
