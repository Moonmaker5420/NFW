[Unit]
Description=NFW Captive Portal (HTTP, LAN only)
Documentation=file:/opt/nfw/docs/PHASE9.md
After=network.target nfw-configd.service
Wants=nfw-configd.service
ConditionPathExists=/opt/nfw/core/portal/main.py

[Service]
Type=simple
User=www-data
Group=nfw
WorkingDirectory=/opt/nfw/core
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/nfw/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/nfw/venv/bin/uvicorn portal.main:app --host 0.0.0.0 --port 8081 --workers 1
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
